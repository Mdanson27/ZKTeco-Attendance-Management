# Install on host only after DNS, certificate issuance and firewall review.
# Replace attendance.example.invalid with confirmed hostname and certificate paths.
# Public HR workspace; ADMS endpoints are deliberately NOT exposed here.
server {
    listen 443 ssl;
    server_name attendance.example.invalid;
    ssl_certificate /etc/letsencrypt/live/attendance.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/attendance.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    access_log off;
    location = / { return 302 /workspace/; }
    location ^~ /workspace/ {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Device-Token "";
    }
    location ^~ /api/workspace/ {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Device-Token "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}
